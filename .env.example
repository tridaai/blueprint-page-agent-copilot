# Page Agent Admin Copilot — configuration.
#
# The copilot's shell needs no key at all: planning, policy, the
# gates, verification and the offline driver are all code. The one
# provider configuration is for PageAgent itself — the in-page agent
# that runs in the operator's browser on the live path. It takes any
# OpenAI-compatible endpoint, in the library's own field names
# (page-agent@1.12.4: `new PageAgent({ model, baseURL, apiKey,
# language })`).

# --- PageAgent LLM (live in-browser path only) ---
# Alibaba's docs example runs Qwen via DashScope:
PAGEAGENT_MODEL=qwen-plus
PAGEAGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
PAGEAGENT_API_KEY=

# OpenAI:
# PAGEAGENT_MODEL=gpt-5.1
# PAGEAGENT_BASE_URL=https://api.openai.com/v1
# PAGEAGENT_API_KEY=sk-...

# NVIDIA NIM, hosted:
# PAGEAGENT_MODEL=nvidia/nemotron-3-super-120b-a12b
# PAGEAGENT_BASE_URL=https://integrate.api.nvidia.com/v1
# PAGEAGENT_API_KEY=nvapi-...

# Self-hosted NIM container / Ollama (local, no key needed):
# PAGEAGENT_MODEL=llama3.1
# PAGEAGENT_BASE_URL=http://localhost:11434/v1
# PAGEAGENT_API_KEY=

PAGEAGENT_LANGUAGE=en-US
# The in-page agent's maxSteps is not set here: the console serves
# it from the shell's governed budget (COPILOT_MAX_EXECUTION_STEPS,
# below) — one ceiling, one home.

# --- Deployment profile ---
# How the agent ships and where the model lives, as one named
# profile: local-hosted (default), local-self-hosted, cdn-hosted,
# cdn-self-hosted. "local" serves the committed bundle built from
# the pinned package; "cdn" serves the script at COPILOT_CDN_URL
# into the page instead. "hosted" is an endpoint outside the
# customer's network and requires PAGEAGENT_API_KEY once one is
# configured; "self-hosted" is an endpoint inside it (a NIM
# container, a vLLM service) and may run keyless. A misconfigured
# profile refuses at startup, by name.
# COPILOT_PROFILE=local-hosted
# The CDN script URL — only for the cdn-* profiles. It must carry
# the pin for the version this repo bundles (1.12.4); any other
# version refuses at startup with both versions named.
# COPILOT_CDN_URL=https://cdn.jsdelivr.net/npm/page-agent@1.12.4/dist/iife/page-agent.demo.js

# --- Store profile ---
# Local default: a single SQLite file (created on first run).
SQLITE_PATH=data/copilot.db
# Production profile: PostgreSQL + pgvector. Setting this one
# variable switches the store; nothing else changes.
# DATABASE_URL=postgresql://copilot:copilot@localhost:5433/copilot

# --- Policy ---
# The largest credit memo the copilot may plan. Above it, plans are
# refused at plan time (not merely gated).
COPILOT_CREDIT_CAP=500.00
# Budgets: the longest plan a task may derive, the most steps one
# execution attempt may run, and an attempt's wall clock in
# seconds. An attempt that reaches a ceiling is stopped by the
# shell and lands as a failed execution naming the budget.
# COPILOT_MAX_PLAN_STEPS=25
# COPILOT_MAX_EXECUTION_STEPS=40
# COPILOT_MAX_EXECUTION_SECONDS=1800
# Clarification patience: the most distinct questions derivation
# may ask one task before a further ambiguity refuses it.
# COPILOT_MAX_CLARIFICATIONS=2
# Dual control: a plan whose total credit reaches this figure —
# or that touches a high-stakes field (a customer's credit
# limit) — is confirmed by two distinct operators, neither of
# them the planner, before it may execute. Defaults to the
# credit cap in force when not set.
# COPILOT_DUAL_CONTROL_CAP=500.00
